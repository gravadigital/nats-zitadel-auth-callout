# .env.example — copy to nats/.env and adjust.  cp -n .env.example .env
#
# ONLY what a person decides goes here. The seeds, creds and pubkeys are generated by the
# bootstrap and exposed through out/callout-env.sh: they are never written by hand.

# --- NATS -----------------------------------------------------------------------------
CALLOUT_NATS_URL=nats://127.0.0.1:4322
NATS_MONITOR_PORT=8322

# --- Server authorization mode --------------------------------------------------------
# Which authorization model the NATS being served uses. It is DECLARED, never inferred:
# guessing it would silently change the authorization model on a typo.
#
# operator = authorization comes from operator-signed account JWTs (nsc). This is what
#            bootstrap.sh generates and the default, so existing setups need nothing.
# config   = authorization lives in nats-server.conf (`authorization { auth_callout { ... } }`).
#            This is the mode for adopting an EXISTING NATS without migrating it. See
#            examples/config-mode/nats-server.conf for a server config to copy.
CALLOUT_SERVER_MODE=operator

# config mode only. The NAME of the account clients land in — not its public key: the server
# resolves the placement by name. In config mode the seeds below collapse to ONE key (the same
# one declared in auth_callout.issuer), and CALLOUT_APP_ACCOUNT_PUB /
# CALLOUT_AUTH_ACCOUNT_SK_SEED do not apply — setting them is an error, not a no-op.
#CALLOUT_TARGET_ACCOUNT=APP

# The callout's OWN connection. Exactly ONE form. It has to be a user the server authorizes
# directly (listed in --auth-user in operator mode, in auth_callout.auth_users in config mode),
# otherwise the callout would be called out against itself.
#   operator mode: a .creds file (what bootstrap.sh generates).
#   config mode:   user/password or an nkey.
#CALLOUT_HANDLER_USER=callout-handler
#CALLOUT_HANDLER_PASSWORD=
#CALLOUT_HANDLER_NKEY_SEED=

# --- Instance -------------------------------------------------------------------------
# Value of the {{instance}} placeholder. In this project's grammar it is the first token of
# every subject (<instance>.<user-id>.<svc>.<method>) and isolates deployments sharing a NATS.
# No dots, wildcards or spaces.
#
# OPTIONAL: leave it empty when adopting an existing subject grammar that has nowhere to put an
# extra leading token. A template that references {{instance}} without one configured fails at
# startup rather than expanding to an empty segment.
CALLOUT_INSTANCE=dev

# --- Inbox ----------------------------------------------------------------------------
# hashed      = each client is scoped to `_INBOX.<hash(user-id)>`. Replies are isolated per
#               user, but EVERY client must set that prefix when connecting
#               (nats.CustomInboxPrefix / inboxPrefix / --inbox-prefix).
# passthrough = the inbox is left alone, for an existing NATS whose clients cannot be changed.
#               The templates then have to grant the inbox they use (typically `_INBOX.>`),
#               which means any client in the account can subscribe to another's replies.
CALLOUT_INBOX_MODE=hashed

# --- Identity -------------------------------------------------------------------------
# mock    = in-process IdP, no secrets and no network. Accepts
#           `mock:<sub>:<user>:<roles>[:<claim=value,...>]` tokens. It is the CI and local
#           development mode. Do NOT use in production.
# zitadel = validates against real Zitadel through JWKS (OIDC discovery).
# oidc    = validates against ANY standards-compliant OIDC provider (Keycloak, Auth0, Okta,
#           Entra), with the claim paths declared below.
CALLOUT_IDP_MODE=mock

# zitadel mode only:
#CALLOUT_IDP_MODE=zitadel
#CALLOUT_ZITADEL_ISSUER_URL=https://your-instance.zitadel.cloud
# Narrows role reading to ONE project. Recommended: it prevents a same-named role from another
# project matching a rule. Empty = the roles of every project in the token are read.
#CALLOUT_ZITADEL_PROJECT_ID=

# oidc mode only:
#CALLOUT_IDP_MODE=oidc
#CALLOUT_OIDC_ISSUER_URL=https://keycloak.example.com/realms/myrealm
# WHERE THE ROLES LIVE. Required, and deliberately not defaulted: there is no cross-provider
# convention, and an unreadable roles claim yields an empty role list — which means no rule
# matches and every connection is refused, with an error pointing at the rules instead.
# Dot-separated for nested claims. Accepts an array, a space/comma-separated string, or an
# object keyed by role name.
#   Keycloak  realm_access.roles
#   Entra     roles
#   Auth0     https://your-app/roles   (namespaced custom claim)
#CALLOUT_OIDC_ROLES_CLAIM=realm_access.roles
#CALLOUT_OIDC_USERNAME_CLAIM=preferred_username
# Strongly recommended: without it, ANY token the provider issued for ANY of its clients
# verifies here.
#CALLOUT_OIDC_AUDIENCE=

# --- Permissions ----------------------------------------------------------------------
# Path to rules.yaml. Templates are resolved relative to THEIR directory, so moving the whole
# config elsewhere only requires changing this variable.
#CALLOUT_RULES_PATH=/etc/auth-callout/rules.yaml

# --- Authentication events (OPTIONAL) -------------------------------------------------
# Publish one event per authenticated connection, carrying the identity that was just verified:
# id, name, email, roles, when it happened. OFF unless a subject is set — the payload holds
# personal data, so nothing publishes it by accident.
#
# Uncomment the subject to turn it on; the credential is already generated
# (out/callout-events.creds).
#
# The STREAM is optional and it picks the delivery mode:
#   set    events go to JetStream and the publisher waits for the ack. A consumer that was down
#          reads what it missed. scripts/run.sh creates the stream with the dev admin credential,
#          because the callout deliberately cannot — this needs the `nats` CLI on PATH.
#   unset  events are plain core NATS messages: only whoever is subscribed at that instant gets
#          one, nothing is stored, and nothing else has to exist.
#CALLOUT_EVENTS_SUBJECT={{instance}}.events.auth
#CALLOUT_EVENTS_STREAM=AUTH_EVENTS

# Which claims the name and the email are read from. The defaults are the OIDC standard ones;
# override them for a provider that puts them elsewhere (dot-separated for nesting).
#CALLOUT_EVENTS_NAME_CLAIM=name
#CALLOUT_EVENTS_EMAIL_CLAIM=email

# --- Logging --------------------------------------------------------------------------
# debug logs the chosen template and the derived identity of every connection.
CALLOUT_LOG_LEVEL=info
