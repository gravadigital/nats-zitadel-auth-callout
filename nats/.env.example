# .env.example — copiar a nats/.env y ajustar.  cp -n .env.example .env
#
# Acá va SOLO lo que decide una persona. Las seeds, creds y pubkeys las genera el
# bootstrap y las expone por out/callout-env.sh: no se escriben a mano.

# --- NATS -----------------------------------------------------------------------------
GESTION_NATS_URL=nats://127.0.0.1:4322
NATS_MONITOR_PORT=8322

# --- Instancia ------------------------------------------------------------------------
# Primer token de TODO subject: <instancia>.<session>.<svc>.<method>. Aísla despliegues
# que comparten el mismo NATS. Sin puntos, wildcards ni espacios.
GESTION_INSTANCE=dev

# --- Identidad ------------------------------------------------------------------------
# mock    = IdP en proceso, sin secretos ni red. Acepta tokens `mock:<sub>:<user>:<roles>`.
#           Es el modo de CI y de desarrollo local. NO usar en producción.
# zitadel = valida contra Zitadel real por JWKS (OIDC discovery).
GESTION_IDP_MODE=mock

# Solo en modo zitadel:
#GESTION_IDP_MODE=zitadel
#GESTION_ZITADEL_ISSUER_URL=https://tu-instancia.zitadel.cloud
# Acota la lectura de roles a UN proyecto. Recomendado: evita que un rol homónimo de otro
# proyecto matchee una regla. Vacío = se leen los roles de todos los proyectos del token.
#GESTION_ZITADEL_PROJECT_ID=

# --- Permisos -------------------------------------------------------------------------
# Path al rules.yaml. Las plantillas se resuelven relativas a SU directorio, así que
# mover el config completo a otro lado solo requiere cambiar esta variable.
#GESTION_RULES_PATH=./config/rules.yaml

# --- Logging --------------------------------------------------------------------------
# debug loguea la plantilla elegida y la identidad derivada de cada conexión.
GESTION_LOG_LEVEL=info
