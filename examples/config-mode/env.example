# Config mode — every variable the callout reads.
#
# Config mode is a NATS whose users and permissions live in nats-server.conf. There is no
# operator and no account JWTs, so the callout is configured with an `auth_callout` block in
# that file — see nats-server.conf next to this one.
#
# The values here line up with that file. Both have to agree, and a mismatch shows up as an
# authorization failure rather than as a startup error, so change them together.

# --- Server -------------------------------------------------------------------------------
CALLOUT_SERVER_MODE=config
CALLOUT_NATS_URL=nats://127.0.0.1:4222

# --- The callout's own connection ---------------------------------------------------------
# The handler user, which MUST be the one listed in `auth_callout.auth_users`. Anything listed
# there BYPASSES the callout and keeps its own permissions — so only the callout belongs in it.
#
# Config mode has no .creds files: use user/password (below) or CALLOUT_HANDLER_NKEY_SEED.
# Exactly one form may be set.
CALLOUT_HANDLER_USER=callout-handler
CALLOUT_HANDLER_PASSWORD=CHANGE-ME-handler

# --- Keys ---------------------------------------------------------------------------------
# ONE key, unlike operator mode. Its PUBLIC half is what nats-server.conf declares as
# `auth_callout.issuer`; the seed goes here, and it signs both the User JWT and the
# authorization_response.
#
#   nats auth nkey gen account --output callout-issuer.nk
CALLOUT_APP_ACCOUNT_SK_SEED=/etc/nats-creds/callout-issuer.seed

# The account clients land in: the NAME as written in the accounts{} block, NOT its public key.
# The server resolves the placement by name — a pubkey here fails with "no valid account" even
# though the key is correct, so the callout rejects one at startup.
CALLOUT_TARGET_ACCOUNT=APP

# Request encryption. Its PUBLIC half is `auth_callout.xkey` in nats-server.conf.
#
#   nats auth nkey gen curve --output callout-xkey.nk
CALLOUT_XKEY_SEED=/etc/nats-creds/callout-xkey.seed

# NOT used in this mode — setting them is a startup ERROR, not a no-op:
#CALLOUT_APP_ACCOUNT_PUB=       # a config-mode server rejects a User JWT carrying issuer_account
#CALLOUT_AUTH_ACCOUNT_SK_SEED=  # one key signs both here

# --- Permissions --------------------------------------------------------------------------
# REQUIRED, no default. rules.yaml and its templates are IDENTICAL in both modes: the mode
# changes how the User JWT is signed, not which permissions go into it.
CALLOUT_RULES_PATH=/etc/auth-callout/rules.yaml

CALLOUT_INSTANCE=dev
CALLOUT_INBOX_MODE=hashed

# --- Identity provider --------------------------------------------------------------------
CALLOUT_IDP_MODE=zitadel
CALLOUT_ZITADEL_ISSUER_URL=https://id.example.com
CALLOUT_ZITADEL_PROJECT_ID=200000000000000002

# --- Authentication events (OPTIONAL) -----------------------------------------------------
# Publish one event per authenticated connection, carrying the identity that was just verified:
# id, name, email, roles, when it happened, and when the session expires. OFF unless the subject
# is set — the payload holds personal data, so nothing publishes it by accident.
#
# The publisher uses a SECOND connection, into the account the event CONSUMERS live in (the APP
# account here), because the callout's own connection is in AUTH and no application client can see
# that account's subjects. See docs/events.md for the stream to create and the three permissions
# the credential needs — and the `allowed_accounts` line in nats-server.conf, without which that
# connection is delegated to the callout too and has no token to present.
#CALLOUT_EVENTS_SUBJECT={{instance}}.events.auth
# OPTIONAL, and it picks how events are delivered:
#   set    published to JetStream and acked; a consumer that was down reads what it missed. You
#          create the stream — the callout cannot — and the credential needs
#          $JS.API.STREAM.INFO.<stream> plus its own inbox.
#   unset  plain core NATS messages: only a consumer subscribed at that instant receives one,
#          nothing is stored, and the credential needs a single publish permission.
#CALLOUT_EVENTS_STREAM=AUTH_EVENTS
#CALLOUT_EVENTS_USER=callout-events
#CALLOUT_EVENTS_PASSWORD=
# Defaults to CALLOUT_NATS_URL: usually the same server, a different account.
#CALLOUT_EVENTS_URL=

# Where the name and the email are read from. The defaults are the OIDC standard claims; a
# provider that nests them takes a dot-separated path.
#CALLOUT_EVENTS_NAME_CLAIM=name
#CALLOUT_EVENTS_EMAIL_CLAIM=email

# How much the verifier asks userinfo for what the TOKEN did not carry: none | username | profile.
# Defaults to `username` in zitadel mode and `none` otherwise, which is what the service did
# before this setting existed.
#
# Set `profile` if you publish the events and want them to name a person: an access token is not
# an ID token, and Zitadel keeps `name` and `email` out of it even with the `profile email` scopes
# granted. The result is cached per identity, so it is one call per user per five minutes rather
# than one per connection.
#CALLOUT_IDP_ENRICH=profile

# --- Logging ------------------------------------------------------------------------------
CALLOUT_LOG_LEVEL=info
