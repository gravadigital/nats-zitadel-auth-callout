# Operator mode — every variable the callout reads.
#
# Operator mode is a NATS whose authorization comes from operator-signed account JWTs
# (`nsc`, a resolver). The callout is configured INSIDE the AUTH account's JWT with
# `nsc edit authcallout`, not in nats-server.conf.
#
# Values marked GENERATED come out of `nats/bootstrap.sh`, which writes them to
# nats/out/callout-env.sh. Against your own NATS, extract them from your nsc store.

# --- Server -------------------------------------------------------------------------------
CALLOUT_SERVER_MODE=operator
CALLOUT_NATS_URL=nats://127.0.0.1:4322

# --- The callout's own connection ---------------------------------------------------------
# The handler user. It MUST be the one declared in `nsc edit authcallout --auth-user`, so the
# server authorizes it directly instead of calling out for it — a callout cannot authorize
# itself.
#
# Operator mode uses a .creds file. Exactly one credential form may be set.
CALLOUT_HANDLER_CREDS=/etc/nats-creds/handler.creds        # GENERATED

# --- Keys ---------------------------------------------------------------------------------
# Two DIFFERENT signing keys, with different jobs:
#   APP  signs the User JWT               -> decides which account the user lands in
#   AUTH signs the authorization_response -> is the issuer the server has configured
#
# Both accept either the seed itself or a path to a file holding it.
CALLOUT_APP_ACCOUNT_SK_SEED=/etc/nats-creds/app-account.sk.seed    # GENERATED
CALLOUT_APP_ACCOUNT_PUB=/etc/nats-creds/app-account.pub           # GENERATED — the IssuerAccount claim
CALLOUT_AUTH_ACCOUNT_SK_SEED=/etc/nats-creds/auth-account.sk.seed # GENERATED

# Request encryption (curve25519). Its PUBLIC half is what goes in
# `nsc edit authcallout --curve`. Leaving it empty means the access token travels in the clear
# over $SYS.REQ.USER.AUTH, which only makes sense if the server has no --curve either.
CALLOUT_XKEY_SEED=/etc/nats-creds/callout-xkey.seed               # GENERATED

# NOT used in this mode — setting them is a startup ERROR, not a no-op:
#CALLOUT_TARGET_ACCOUNT=      # config mode places users by name; operator mode by pubkey

# --- Permissions --------------------------------------------------------------------------
# REQUIRED, no default. Templates resolve relative to THIS file's directory, so moving the
# whole configuration elsewhere only means changing this one variable.
CALLOUT_RULES_PATH=/etc/auth-callout/rules.yaml

# The {{instance}} placeholder: the first token of every subject in this example's grammar.
# OPTIONAL — omit it if your templates never reference {{instance}}. Configuring one that no
# template uses is a startup error, and so is the reverse.
CALLOUT_INSTANCE=dev

# hashed (default) scopes each client to `_INBOX.<hash(user-id)>` and requires every client to
# set that prefix when connecting. passthrough drops that requirement for clients you cannot
# change, at the cost of per-user reply isolation.
CALLOUT_INBOX_MODE=hashed

# --- Identity provider --------------------------------------------------------------------
# mock    = in-process, accepts `mock:<sub>:<user>:<roles>`. No secrets, no network. NOT for
#           production: it accepts any identity a client claims.
# zitadel = validates against Zitadel through JWKS (OIDC discovery).
# oidc    = any standards-compliant provider, with the roles claim declared below.
CALLOUT_IDP_MODE=zitadel
CALLOUT_ZITADEL_ISSUER_URL=https://id.example.com
# Narrows role reading to ONE project. Recommended: without it a same-named role from another
# project could match a rule.
CALLOUT_ZITADEL_PROJECT_ID=200000000000000002

# --- Logging ------------------------------------------------------------------------------
CALLOUT_LOG_LEVEL=info
