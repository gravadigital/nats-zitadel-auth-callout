# NATS identity generated by nats/bootstrap.sh: operator, accounts, signing keys, creds and
# the callout's XKey. NEVER commit — these are the keys that sign the User JWTs.
/nats/out/

# JetStream data (the KV buckets).
/nats/data/

# Local config.
/nats/.env

# Binaries.
/bin/

# Service user credentials downloaded from Zitadel.
/secrets/
